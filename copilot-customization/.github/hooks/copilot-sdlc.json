  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python \".sdlc\\hooks\\tracking_hook.py\"",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
